@using Application.DTOs
@using Application.Interfaces.Pagination
@using WebUI.Services.HourServices
@using WebUI.Services.WorkerServices

@inject IWorkerService workerService
@inject IHourService hourService
@inject CurrentUserDto currentUser
@inject ISnackbar Snackbar

@if (isLoading)
{
    <MudProgressCircular Color="Color.Primary" Style="height:100px; width:100px; position:fixed; top:40%; left:50%;" Indeterminate="true" />
}

<MudDialog>
    <DialogContent>
        <EditForm Model="workerFormDetails">
            <DataAnnotationsValidator />
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="WorkerHours.WorkerName" For="@(() => WorkerHours.WorkerName)" Label="Nume" ReadOnly Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Day" For="@(() => Day)" Label="Ziua" ReadOnly Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12">
                    <MudSelect T="HourDto" MultiSelection="false" @bind-Value="Hour" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" Class="form-select-sm" Label="Valorile de pontaj">
                        @foreach (var hour in hours)
                        {
                            <MudSelectItem Value="@hour" Class="form-select-sm">@hour.Value - @hour.Label</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudGrid Justify="Justify.FlexEnd">
                    <MudItem>
                        <MudButton OnClick="Save" Variant="Variant.Filled" Color="Color.Success">Salvează</MudButton>
                        <MudButton OnClick="Cancel" Variant="Variant.Filled">Anulează</MudButton>
                    </MudItem>
                </MudGrid>
            </MudGrid>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    PaginationParameter paginationParameters = new PaginationParameter();

    [CascadingParameter]
    MudDialogInstance MudDialog { get; set; }

    [Parameter]
    public WorkerHoursDto WorkerHours { get; set; }

    [Parameter]
    public int Day { get; set; }

    [Parameter]
    public int HoursWorked { get; set; }

    public HourDto Hour { get; set; }

    [Parameter]
    public Func<Task> Callback { get; set; }

    void Cancel() => MudDialog.Cancel();

    WorkerDto workerFormDetails = new WorkerDto();
    private List<HourDto> hours = new List<HourDto>();

    string message = string.Empty;
    string messageCssClass = string.Empty;
    private bool isLoading = true;

    protected async override Task OnInitializedAsync()
    {
        isLoading = false;
        hours = await hourService.GetHourList();
        Hour = hours.FirstOrDefault(h => h.Value == HoursWorked) ?? new HourDto { Value = HoursWorked };
        StateHasChanged();
    }

    private async Task Save()
    {
        var result = await workerService.WorkerHourEdit(WorkerHours, Day, Hour.Value);

        await Callback?.Invoke();
        MudDialog.Close();
    }
}