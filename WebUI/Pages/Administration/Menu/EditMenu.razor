@page "/edit-nav-menu"

@using System.Collections.Generic;
@using Application.DTOs
@using MudBlazor;
@using System.Linq;
@using WebUI.Services.MenuServices;
@using WebUI.Pages.Administration.Menu.Components

@inject IJSRuntime JSRuntime
@inject IMenuService menuService
@inject IDialogService dialogsService
@inject NavigationManager navigationManager

<AuthorizeView Context="view">

    @if (isLoadingType)
    {
        <MudProgressCircular Color="Color.Primary" Style="height:100px; width:100px; position:fixed; top:40%; left:50%;" Indeterminate="true" />
    }
    else
    {
        <MudList Clickable="true">
            @foreach (var item in pageNames)
            {
                <MudListItem>
                    <MudGrid Spacing="2" Justify="Justify.SpaceBetween" Class="d-flex align-center">
                        <MudItem xs="12" sm="6" Class="d-flex align-center">
                            <MudCheckBox @bind-Checked="@item.IsChecked" ReadOnly />
                            <MudText Typo="Typo.body1" Class="ml-2">@item.OriginalName</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="6" Class="d-flex justify-end">
                            <MudButton Variant="Variant.Filled" Color="Color.Default" Size="Size.Small" OnClick="@(() => EditItem(item))">Edit</MudButton>
                        </MudItem>
                    </MudGrid>
                </MudListItem>
                <MudDivider />
            }
        </MudList>
    }
</AuthorizeView>

@code {
    public bool isLoadingType = true;
    private List<MenuDto> pageNames = new List<MenuDto>();

    protected override async void OnInitialized()
    {
        pageNames = await menuService.GetMenu();
        isLoadingType = false;
        StateHasChanged();
    }

    private async Task EditItem(MenuDto item)
    {
        var dialog = default(IDialogReference);
        var parameters = new DialogParameters();
        var callback = async () => { await OnInitializedAsync(); };

        var options = new DialogOptions
            {
                MaxWidth = MudBlazor.MaxWidth.Large
            };

        parameters.Add("MenuDto", item);

        dialog = dialogsService.Show<EditMenuItemDialog>("Editare Element Meniu", parameters);
        var result = await dialog.Result;

        if (!result.Cancelled)
        {
            var updatedMenuDto = (MenuDto)result.Data;
            var updatedItem = await menuService.EditMenu(updatedMenuDto);

            if (updatedItem != null)
            {
                var index = pageNames.FindIndex(p => p.Id == updatedItem.Id);
                if (index != -1)
                {
                    pageNames[index] = updatedItem;
                }
                navigationManager.NavigateTo("/edit-nav-menu", true);
            }
        }
    }
}