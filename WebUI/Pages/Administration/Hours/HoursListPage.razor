@page "/hours"
@layout MainLayout

@using Application.DTOs
@using Application.Interfaces.Pagination
@using WebUI.Pages.Administration.Hours.Components
@using WebUI.Services.HourServices

@inject IHourService hourService
@inject IDialogService dialogsService

<AuthorizeView Context="view">

    @if (isLoadingType)
    {
        <MudProgressCircular Color="Color.Primary" Style="height:100px; width:100px; position:fixed; top:40%; left:50%;" Indeterminate="true" />
    }
    else
    {
        <AuthorizeView>
            <div class="d-flex justify-end flex-grow-1 gap-4 mb-2 mt-4">
                <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="()=>OpenDialog()" Variant="Variant.Outlined" Color="Color.Primary" Class="ml-auto">Adaugă ore</MudButton>
            </div>
        </AuthorizeView>

        <MudTable Items="hours" T="HourDto">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Ore de lucru</MudText>
                <MudSpacer />
            </ToolBarContent>
            <HeaderContent>
                <MudTh>Nume</MudTh>
                <MudTh>Ore</MudTh>
                <MudTh>Acțiuni</MudTh>
            </HeaderContent>
            <RowTemplate Context="context">
                <MudTd>@context.Label</MudTd>
                <MudTd>@context.Value</MudTd>
                <MudTd>
                    <AuthorizeView Context="delete">
                        <MudButton Variant="Variant.Outlined" OnClick="()=>OpenDialog(context.Id, true)" Color="Color.Error"><MudIcon Icon="@Icons.Material.Filled.Delete" Size="@Size.Small" /></MudButton>
                    </AuthorizeView>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</AuthorizeView>

@code {
    public bool isLoadingType = true;

    private List<HourDto> hours = new List<HourDto>();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        isLoadingType = false;
        StateHasChanged();
    }

    private async Task LoadData()
    {
        var result = await hourService.GetHourList();

        if (result == null)
        {
            hours = new List<HourDto>();
        }
        else
        {
            var newList = result.ToList();
            hours = newList;
            StateHasChanged();
        }
    }

    private void OpenDialog(Guid? content = null, bool delete = false)
    {
        var dialog = default(IDialogReference);
        var parameters = new DialogParameters();
        var callback = async () => { await OnInitializedAsync(); };

        var options = new DialogOptions
            {
                MaxWidth = MudBlazor.MaxWidth.Large
            };

        parameters.Add("HourId", content);
        parameters.Add("callback", callback);

        if (delete) dialog = dialogsService.Show<DeleteComponent>("Sunteți sigur că doriți să ștergeți această oră de lucru ?", parameters, options);
        else dialog = dialogsService.Show<AddHourComponent>("Detalii oră de lucru", parameters, options);
    }
}
