@page "/workers-hours"
@layout MainLayout

@using Application.DTOs
@using WebUI.Pages.Administration.Workers.Components
@using WebUI.Services.WorkerServices

@inject IWorkerService workerService
@inject IDialogService dialogsService

<MudText Typo="Typo.h6">Tabelul de pontaj</MudText>
<br />
<MudGrid Spacing="2">
    <MudItem xs="6" sm="4">
        <MudDatePicker @bind-Date="SelectedDate"
                       @bind-Date:after="OnDateChanged"
                       Label="Selectează Luna și Anul"
                       For="@(() => SelectedDate)"
                       DateFormat="MMMM yyyy"
                       Variant="Variant.Outlined" />
    </MudItem>
</MudGrid>
<br />
<MudTable Items="workerHours" T="WorkerHoursDto">
    <HeaderContent>
        <MudTh>Nume lucrător</MudTh>
        <MudTh>Total ore</MudTh>
        @if (SelectedDate.HasValue)
        {
            foreach (var day in DaysInMonth)
            {
                try
                {
                    var date = new DateTime(SelectedDate.Value.Year, SelectedDate.Value.Month, day);
                    <MudTh>@day @date.ToString("ddd")</MudTh>
                }
                catch (ArgumentOutOfRangeException)
                {
                    <MudTh>Eroare dată</MudTh>
                }
            }
        }
    </HeaderContent>
    <RowTemplate Context="context">
        <MudTd>@context.WorkerName</MudTd>
        <MudTd>@context.HoursWorked</MudTd>
        @if (SelectedDate.HasValue)
        {
            var daysInMonth = DateTime.DaysInMonth(SelectedDate.Value.Year, SelectedDate.Value.Month);
            @for (int i = 1; i <= daysInMonth; i++)
            {
                var dailyHours = context.DailyWorkHours.FirstOrDefault(x => x.Day == i);
                <MudTd>
                    <MudButton OnClick="()=>OpenModal(context, dailyHours.Day, dailyHours.HoursWorked)" Style="padding: 0px; margin: -25px">
                        @(dailyHours?.HoursWorked ?? 0)
                    </MudButton>
                </MudTd>
            }
        }
    </RowTemplate>
</MudTable>
<br />

@code {
    private int previousMonth;
    private int previousYear;

    private List<int> DaysInMonth { get; set; } = new List<int>();
    private List<WorkerHoursDto> workerHours = new List<WorkerHoursDto>();
    private DateTime? SelectedDate { get; set; } = DateTime.Now;

    protected override async Task OnInitializedAsync()
    {
        await LoadWorkerHours();
        StateHasChanged();
    }

    private async Task OnDateChanged()
    {
        await LoadWorkerHours();
        StateHasChanged();
    }

    private async Task LoadWorkerHours()
    {
        if (SelectedDate.HasValue)
        {
            int currentMonth = SelectedDate.Value.Month;
            int currentYear = SelectedDate.Value.Year;

            if (currentMonth == previousMonth || currentYear == previousYear)
            {
                previousMonth = currentMonth - 1;
                previousYear = currentYear - 1;
            }
            else
            {
                previousMonth = currentMonth;
                previousYear = currentYear;
            }

            DaysInMonth.Clear();
            int daysInMonth = DateTime.DaysInMonth(SelectedDate.Value.Year, SelectedDate.Value.Month);
            for (int i = 1; i <= daysInMonth; i++)
            {
                DaysInMonth.Add(i);
            }

            workerHours = await workerService.GetWorkerHours(currentMonth, currentYear);
        }
    }

    private void OpenModal(WorkerHoursDto workerHours, int day, int hoursWorked)
    {
        var dialog = default(IDialogReference);
        var parameters = new DialogParameters();
        var callback = async () => { await OnInitializedAsync(); };

        var options = new DialogOptions
            {
                MaxWidth = MudBlazor.MaxWidth.Large
            };

        parameters.Add("WorkerHours", workerHours);
        parameters.Add("Day", day);
        parameters.Add("HoursWorked", hoursWorked);
        parameters.Add("callback", callback);

        dialog = dialogsService.Show<EditWorkerHourComponent>("Detalii ore de lucru", parameters, options);
    }
}
