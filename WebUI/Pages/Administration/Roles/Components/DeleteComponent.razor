@using WebUI.Services.RoleServices

@inject IRoleService roleService

<MudDialog>
    <DialogActions>
        <MudButton Variant="Variant.Filled" OnClick="@(() => UserDelete(@RoleId))" ButtonType="ButtonType.Submit" Color="Color.Error">Da</MudButton>
        <MudButton Variant="Variant.Filled" OnClick="Cancel">Anulează</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    MudDialogInstance MudDialog { get; set; }

    [Parameter]
    public Guid RoleId { get; set; }

    [Parameter]
    public Func<Task> Callback { get; set; }

    void Cancel() => MudDialog.Cancel();

    private async Task UserDelete(Guid roleId)
    {
        await roleService.RoleDelete(roleId);

        Callback?.Invoke();
        MudDialog.Close();
    }
}
